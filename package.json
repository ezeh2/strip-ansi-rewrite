{
  "name": "strip-ansi-rewrite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node demo.mjs",
    "test": "node demo.mjs",
    "test:differential": "cargo build --offline --quiet && node tests/differential.mjs",
    "flower:colors": "cat examples/flower-garden.ans",
    "flower:npm": "node --input-type=module -e \"import fs from 'node:fs'; import stripAnsi from 'strip-ansi'; process.stdout.write(stripAnsi(fs.readFileSync('examples/flower-garden.ans', 'utf8')));\"",
    "flower:cargo": "cargo run --offline --quiet --bin strip-ansi < examples/flower-garden.ans"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "strip-ansi": "^7.2.0"
  }
}
